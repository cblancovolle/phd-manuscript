\begin_layout Plain Layout
Side-by-side comparison of the shapes in 2D of activation surface of oCELL 
\begin_inset CommandInset ref
LatexCommand eqref
reference "fig:Orthotope-Activation-Surface"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 and kCELL 
\begin_inset CommandInset ref
LatexCommand eqref
reference "fig:RBF-Activation-Surface"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 agents.
 The yellow color corresponds to highly activated regions and blue color corresponds to lower activated regions.
 
\begin_inset CommandInset label
LatexCommand label
name "fig:Comparison-Activation-Surfaces"

\end_inset


\end_layout

\end_inset


